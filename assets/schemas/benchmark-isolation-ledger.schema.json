{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/craft-cumcm-national-paper/benchmark-isolation-ledger.schema.json",
  "title": "CUMCM historical benchmark isolation ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "benchmark_id",
    "evaluation_mode",
    "case_id",
    "prior_model_memory",
    "pre_freeze_resources",
    "frozen_artifacts",
    "frozen_at",
    "unblinded_at",
    "declared_solution_blind"
  ],
  "properties": {
    "version": {"const": 1},
    "stage": {"enum": ["pre_freeze", "frozen", "unblinded"]},
    "benchmark_id": {"type": "string", "minLength": 1},
    "evaluation_mode": {
      "enum": [
        "retrospective_historical",
        "cross_case_assisted_historical",
        "prospective_unseen"
      ]
    },
    "case_id": {"type": "string", "minLength": 2},
    "prior_model_memory": {
      "enum": ["unknown", "none_declared", "known_same_case"]
    },
    "pre_freeze_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "category", "case_scope"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "official_problem",
              "official_attachment",
              "generic_skill",
              "tool_instruction",
              "same_case_solution",
              "official_sample_index",
              "official_sample_casebook",
              "cross_case_pattern_library",
              "cross_case_raw_paper",
              "cross_case_index",
              "award_paper",
              "public_code",
              "search_snippet",
              "unknown"
            ]
          },
          "case_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "frozen_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "frozen_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "unblinded_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "declared_solution_blind": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"required": ["stage"], "properties": {"stage": {"const": "pre_freeze"}}},
      "then": {
        "properties": {
          "frozen_artifacts": {"maxItems": 0},
          "frozen_at": {"type": "null"},
          "unblinded_at": {"type": "null"},
          "declared_solution_blind": {"const": false}
        }
      }
    },
    {
      "if": {"required": ["stage"], "properties": {"stage": {"enum": ["frozen", "unblinded"]}}},
      "then": {
        "properties": {
          "frozen_artifacts": {"minItems": 1},
          "frozen_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"required": ["stage"], "properties": {"stage": {"const": "frozen"}}},
      "then": {"properties": {"unblinded_at": {"type": "null"}}}
    },
    {
      "if": {"required": ["stage"], "properties": {"stage": {"const": "unblinded"}}},
      "then": {"properties": {"unblinded_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
