{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/craft-cumcm-national-paper/strategy-contract.schema.json",
  "title": "Solver-ready CUMCM strategy contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "problem_id", "source_manifest", "source_reconciliation", "subproblems", "workbook_range_mappings", "information_structure", "innovation_contract", "model_route", "formulation", "validation", "output_contract", "locked_decisions", "open_decisions"],
  "properties": {
    "version": {"const": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "source_manifest": {"type": "string", "minLength": 1},
    "source_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_report", "reconciliation_record"],
      "properties": {
        "audit_report": {"type": "string", "minLength": 1},
        "reconciliation_record": {"type": "string", "minLength": 1}
      }
    },
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operative_question",
          "dependencies",
          "inputs",
          "unknowns",
          "decision_variables",
          "method",
          "objectives",
          "constraints",
          "result_fields",
          "validation_ids"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "operative_question": {"type": "string", "minLength": 3},
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "source", "locator", "unit", "availability_timing"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {
                  "enum": ["scalar", "vector", "table", "matrix", "image", "text", "network", "trajectory", "distribution"]
                },
                "source": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "availability_timing": {"type": "string", "minLength": 1}
              }
            }
          },
          "unknowns": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "decision_variables": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "method": {"type": "string", "minLength": 3},
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "result_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "unit", "machine_path", "paper_location", "acceptance"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {"enum": ["scalar", "vector", "table", "matrix", "figure", "policy", "trajectory", "classification", "text"]},
                "unit": {"type": "string", "minLength": 1},
                "machine_path": {"type": "string", "minLength": 1},
                "paper_location": {"type": "string", "minLength": 1},
                "acceptance": {"type": "string", "minLength": 3}
              }
            }
          },
          "validation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "workbook_range_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sheet", "range", "role", "fields", "units", "used_by_subproblems"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sheet": {"type": "string", "minLength": 1},
          "range": {"type": "string", "pattern": "^[^!]+![A-Z]+[0-9]+(?::[A-Z]+[0-9]+)?$"},
          "role": {"enum": ["input", "required_output", "reference", "validation"]},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "used_by_subproblems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "information_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_timeline", "observation_timing", "uncertainty_semantics", "multi_agent_semantics"],
      "properties": {
        "decision_timeline": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observation_timing": {"type": "string", "minLength": 3},
        "uncertainty_semantics": {"type": "string", "minLength": 3},
        "multi_agent_semantics": {"type": "string", "minLength": 3}
      }
    },
    "innovation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tournament_file",
        "tournament_sha256",
        "audit_report",
        "audit_report_sha256",
        "primary_candidate",
        "supporting_candidates"
      ],
      "properties": {
        "tournament_file": {"type": "string", "minLength": 1},
        "tournament_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "audit_report": {"type": "string", "minLength": 1},
        "audit_report_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "primary_candidate": {"type": "string", "minLength": 1},
        "supporting_candidates": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "model_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "recommended", "structural_insight"],
      "properties": {
        "baseline": {"type": "string", "minLength": 3},
        "recommended": {"type": "string", "minLength": 3},
        "structural_insight": {"type": "string", "minLength": 3}
      }
    },
    "formulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables", "parameters", "objective", "constraints", "data_transforms", "solver", "fallback"],
      "properties": {
        "variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "objective": {"type": "string", "minLength": 3},
        "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "data_transforms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "solver": {"type": "string", "minLength": 3},
        "fallback": {"type": "string", "minLength": 3}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "acceptance_thresholds", "failure_tests"],
      "properties": {
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance_thresholds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_command", "machine_results", "verification_commands", "required_files"],
      "properties": {
        "entry_command": {"type": "string", "minLength": 1},
        "machine_results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "locked_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "open_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
