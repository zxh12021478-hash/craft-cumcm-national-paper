{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/craft-cumcm-national-paper/benchmark-output-closure.schema.json",
  "title": "CUMCM benchmark official-output closure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "created_at", "pre_pilot_manifest", "requirements"],
  "properties": {
    "version": {"const": 1},
    "case_id": {"type": "string", "minLength": 2},
    "created_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "pre_pilot_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "frozen_at", "first_pilot_started_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "frozen_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "first_pilot_started_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "official_locator", "required", "status", "artifact_path", "artifact_sha256", "content_checks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "official_locator": {"type": "string", "minLength": 3},
          "required": {"type": "boolean"},
          "status": {"enum": ["complete", "missing", "not_applicable"]},
          "artifact_path": {"type": "string", "minLength": 1},
          "artifact_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
          "content_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type"],
              "properties": {
                "type": {"enum": ["file_nonempty", "json_pointer_nonempty", "xlsx_range_nonempty", "text_marker"]}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
