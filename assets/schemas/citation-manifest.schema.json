{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/craft-cumcm-national-paper/citation-manifest.schema.json",
  "title": "CUMCM citation verification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "citations"],
  "properties": {
    "version": {"const": 1},
    "citation_style": {"type": "string"},
    "competition_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "competition_year", "evidence_cutoff_date"],
      "properties": {
        "mode": {"enum": ["live_competition", "retrospective"]},
        "competition_year": {"type": "integer", "minimum": 2000, "maximum": 2200},
        "evidence_cutoff_date": {"type": "string", "format": "date"}
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "authors", "year", "source_type", "verified_at", "verified_by", "verification_evidence", "claims"],
        "properties": {
          "id": {"type": "string", "pattern": "^\\d+$"},
          "title": {"type": "string", "minLength": 2},
          "authors": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          },
          "year": {"oneOf": [{"type": "integer", "minimum": 1800, "maximum": 2200}, {"type": "string", "pattern": "^\\d{4}$"}]},
          "venue": {"type": "string"},
          "source_type": {"enum": ["primary", "official", "standard", "dataset", "secondary"]},
          "doi": {"type": "string"},
          "url": {"type": "string"},
          "verified_at": {"type": "string", "format": "date"},
          "verified_by": {"type": "string", "minLength": 1},
          "verification_source": {"type": "string"},
          "verification_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_snapshot_sha256", "bibliographic_locator", "claim_check"],
            "properties": {
              "source_snapshot_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "bibliographic_locator": {"type": "string", "minLength": 3},
              "claim_check": {"type": "string", "minLength": 10}
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["paper_location", "claim", "support_note"],
              "properties": {
                "paper_location": {"type": "string", "minLength": 1},
                "claim": {"type": "string", "minLength": 1},
                "support_note": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "anyOf": [{"required": ["doi"]}, {"required": ["url"]}]
      }
    }
  }
}
